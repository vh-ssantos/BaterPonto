<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/journey_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@android:color/primary_text_light" />
    <Chronometer android:id="@+id/journey_clock" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:textColor="@android:color/secondary_text_light" />
    <ImageView android:id="@+id/journey_bar" android:layout_width="match_parent"
        android:layout_height="10dp" android:layout_marginTop="8dp"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/journey_detail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp"
        android:textColor="@android:color/secondary_text_light" />
</LinearLayout>
